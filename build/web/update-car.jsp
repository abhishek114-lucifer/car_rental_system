<%@ page contentType="text/html;charset=UTF-8" import="dao.CarDAO,model.Car,model.User,util.Html" %><% User user=(User)session.getAttribute("user");if(user==null||!"admin".equals(user.getRole())){response.sendError(403);return;}Car car=null;String error=(String)request.getAttribute("error");try{car=new CarDAO().findById(Integer.parseInt(request.getParameter("id")));}catch(Exception e){error=e.getMessage();}%><!DOCTYPE html><html><head><title>Update car | DriveEasy</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><nav><a class="brand" href="${pageContext.request.contextPath}/admin.jsp">DRIVEEASY / ADMIN</a><a href="${pageContext.request.contextPath}/logout">Log out</a></nav><main class="form-page"><div class="form-card wide"><p class="eyebrow">FLEET MANAGEMENT</p><h1>Update car</h1><%if(error!=null){%><div class="message error"><%=Html.escape(error)%></div><%}if(car!=null){%><form method="post" action="${pageContext.request.contextPath}/update-car"><input type="hidden" name="id" value="<%=car.getId()%>"><label>Car name<input name="carName" value="<%=Html.escape(car.getCarName())%>" required></label><label>Model / year<input name="model" value="<%=Html.escape(car.getModel())%>" required></label><label>Price per day (INR)<input type="number" name="pricePerDay" value="<%=car.getPricePerDay()%>" min="0.01" step="0.01" required></label><label>Online image URL<input type="url" name="imageUrl" value="<%=Html.escape(car.getImageUrl())%>" required></label><label>Status<select name="status"><option <%if("Available".equals(car.getStatus())){%>selected<%}%>>Available</option><option <%if("Booked".equals(car.getStatus())){%>selected<%}%>>Booked</option></select></label><button class="button" type="submit">Save changes <span>-></span></button></form><%}%></div></main></body></html>