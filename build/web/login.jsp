<%@ page contentType="text/html;charset=UTF-8" %><% String error=(String)request.getAttribute("error"); String flash=(String)session.getAttribute("flash"); session.removeAttribute("flash"); %>
<!DOCTYPE html><html><head><title>Log in | DriveEasy</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><nav><a class="brand" href="${pageContext.request.contextPath}/index.jsp">DRIVEEASY</a><a href="${pageContext.request.contextPath}/register.jsp">Create account</a></nav><main class="form-page"><div class="form-card"><p class="eyebrow">WELCOME BACK</p><h1>Log in</h1><p class="muted">Pick up where you left off.</p><% if(flash!=null){ %><div class="message success"><%=flash%></div><% } %><% if(error!=null){ %><div class="message error"><%=error%></div><% } %><form method="post" action="${pageContext.request.contextPath}/login"><label>Email<input type="email" name="email" required></label><label>Password<input type="password" name="password" required></label><button class="button" type="submit">Log in <span>-></span></button></form><p class="form-foot">New here? <a href="${pageContext.request.contextPath}/register.jsp">Register now</a></p></div></main></body></html>