<%@ page contentType="text/html;charset=UTF-8" import="dao.BookingDAO,model.Booking,model.User,util.CurrencyFormatter,util.Html,java.util.List" %><% User user=(User)session.getAttribute("user"); if(user==null){ response.sendRedirect("login.jsp"); return; } List<Booking> bookings=null; String error=null; String flash=(String)session.getAttribute("flash"); session.removeAttribute("flash"); try{bookings=new BookingDAO().findByUser(user.getId());}catch(Exception e){error=e.getMessage();} %>
<!DOCTYPE html><html><head><title>My bookings | DriveEasy</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><nav><a class="brand" href="${pageContext.request.contextPath}/dashboard.jsp">DRIVEEASY</a><div><a href="${pageContext.request.contextPath}/cars.jsp">Available cars</a><a href="${pageContext.request.contextPath}/logout">Log out</a></div></nav><main class="page"><div class="page-heading"><div><p class="eyebrow">YOUR JOURNEY</p><h1>My bookings</h1></div><a class="button small" href="${pageContext.request.contextPath}/book.jsp">New booking <span>-></span></a></div><%if(flash!=null){%><div class="message success"><%=Html.escape(flash)%></div><%}if(error!=null){%><div class="message error"><%=Html.escape(error)%></div><%}else if(bookings.isEmpty()){%><div class="empty">You have no bookings yet.</div><%}else{%><div class="table-wrap"><table><thead><tr><th>Car</th><th>Dates</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody><%for(Booking b:bookings){%><tr><td><strong><%=Html.escape(b.getCarName())%></strong></td><td><%=b.getRentDate()%> to <%=b.getReturnDate()%></td><td><%=CurrencyFormatter.inr(b.getTotalAmount())%></td><td><span class="status <%=b.getStatus().toLowerCase()%>"><%=Html.escape(b.getStatus())%></span></td><td><%if("Booked".equals(b.getStatus())){%><form method="post" action="${pageContext.request.contextPath}/return-car"><input type="hidden" name="bookingId" value="<%=b.getId()%>"><button class="link-button" type="submit">Return car</button></form><%}%></td></tr><%}%></tbody></table></div><%}%></main></body></html>