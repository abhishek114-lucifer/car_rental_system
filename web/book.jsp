<%@ page contentType="text/html;charset=UTF-8" import="dao.CarDAO,model.Car,model.User,util.CurrencyFormatter,util.Html,java.util.List" %><% User user=(User)session.getAttribute("user"); if(user==null){ response.sendRedirect("login.jsp"); return; } List<Car> cars=null; String error=(String)request.getAttribute("error"); try{cars=new CarDAO().findAvailable();}catch(Exception e){error=e.getMessage();} %>
<!DOCTYPE html><html><head><title>Book a car | DriveEasy</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><nav><a class="brand" href="${pageContext.request.contextPath}/dashboard.jsp">DRIVEEASY</a><a href="${pageContext.request.contextPath}/logout">Log out</a></nav><main class="form-page"><div class="form-card wide"><p class="eyebrow">MAKE IT YOURS</p><h1>Book a car</h1><%if(error!=null){%><div class="message error"><%=Html.escape(error)%></div><%}%><form method="post" action="${pageContext.request.contextPath}/book-car"><label>Choose a car<select name="carId" required><%if(cars!=null)for(Car car:cars){%><option value="<%=car.getId()%>" <%if(String.valueOf(car.getId()).equals(request.getParameter("carId"))){%>selected<%}%>><%=Html.escape(car.getCarName())%> - <%=CurrencyFormatter.inr(car.getPricePerDay())%>/day</option><%}%></select></label><div class="two-col"><label>Rent date<input type="date" name="rentDate" required></label><label>Return date<input type="date" name="returnDate" required></label></div><p class="hint">Your total is calculated from the selected dates.</p><button class="button" type="submit">Confirm booking <span>-></span></button></form></div></main></body></html>